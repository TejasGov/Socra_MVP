{
  "name": "socra-pilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k -n web,worker -c blue,magenta \"next dev --port 3000\" \"tsx watch --clear-screen=false --conditions=react-server worker/index.ts\"",
    "dev:web": "next dev --port 3000",
    "build": "prisma generate && next build && npm run build:worker",
    "build:worker": "node scripts/build-worker.mjs",
    "start": "next start --port 3000",
    "worker": "tsx --conditions=react-server worker/index.ts",
    "lint": "eslint .",
    "typecheck": "prisma generate && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "node scripts/migrate-new.mjs",
    "db:seed": "tsx --conditions=react-server prisma/seed/index.ts",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "runner:pull": "node scripts/runner-pull.mjs",
    "postinstall": "prisma generate",
    "ai:embed": "tsx --conditions=react-server scripts/backfill-embeddings.ts"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@prisma/adapter-pg": "~7.10.0",
    "@prisma/client": "~7.10.0",
    "@uiw/react-codemirror": "^4.25.12",
    "bcryptjs": "~3.0.3",
    "bullmq": "~6.3.11",
    "dotenv": "~18.0.5",
    "ioredis": "~6.0.0",
    "lucide-react": "^1.52.0",
    "next": "~16.3.8",
    "openai": "~7.28.0",
    "openid-client": "~6.8.8",
    "papaparse": "^5.7.0",
    "pg": "~8.23.1",
    "prisma": "~7.10.0",
    "react": "~19.3.0",
    "react-dom": "~19.3.0",
    "react-markdown": "^10.1.0",
    "server-only": "0.0.1",
    "zod": "~4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "~1.63.0",
    "@tailwindcss/postcss": "~4.3.3",
    "@types/node": "~22.20.5",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "~8.23.1",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "concurrently": "~10.0.5",
    "esbuild": "~0.28.2",
    "eslint": "~9.39.5",
    "eslint-config-next": "~16.3.8",
    "prettier": "~3.9.9",
    "prettier-plugin-tailwindcss": "~0.8.1",
    "tailwindcss": "~4.3.3",
    "tsx": "~4.23.15",
    "typescript": "~6.0.3",
    "vite-tsconfig-paths": "~6.1.1",
    "vitest": "~5.0.3"
  }
}
