# Socra Pilot Research V1 — environment configuration.
# Copy to .env.local for local development:   cp .env.example .env.local
# Next.js, the worker, the seed, and prisma.config.ts all load .env.local first, then .env.
# Everything runs with NO paid credentials: empty OpenAI/OIDC/S3/remote-runner values select local/mock adapters.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_URL=http://localhost:3000
APP_VERSION=0.1.0
# Trust X-Forwarded-For / X-Forwarded-Host / X-Forwarded-Proto. Set true ONLY behind a reverse proxy that overwrites
# them; otherwise clients can spoof their IP (login rate limit, audit log) and the CSRF host check.
TRUST_PROXY=false
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Data stores (docker compose maps Postgres -> 5544 and Redis -> 6390 on the host)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://socra:socra@localhost:5544/socra?schema=public
REDIS_URL=redis://localhost:6390

# ---------------------------------------------------------------------------
# Sessions and authentication
# ---------------------------------------------------------------------------
# >= 32 random characters in production (e.g. `openssl rand -hex 32`). Required when NODE_ENV=production.
SESSION_SECRET=dev-only-change-me-dev-only-change-me-0000
SESSION_TTL_HOURS=12
# Local email + password accounts (seeded demo users). Disable once SSO is live.
AUTH_LOCAL_ENABLED=true
RATE_LIMIT_LOGIN_PER_15_MIN=20

# University SSO via generic OpenID Connect (authorization code + PKCE).
# Leave empty to disable; /api/auth/oidc/start then returns 503 with an explanation.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/api/auth/oidc/callback
OIDC_SCOPES=openid email profile
OIDC_EMAIL_CLAIM=email
# false = only pre-provisioned users (roster) may sign in via SSO.
OIDC_AUTO_PROVISION=false

# ---------------------------------------------------------------------------
# AI (OpenAI Responses API). Empty key => AI_MOCK_MODE (deterministic mock provider).
# ---------------------------------------------------------------------------
# Leave AI_MOCK_MODE empty to derive it from OPENAI_API_KEY; set true to force mock even with a key.
AI_MOCK_MODE=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_ORG_ID=
OPENAI_PROTECTED_MODEL=gpt-6.1-sol
OPENAI_ECONOMY_MODEL=gpt-6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TIMEOUT_MS=30000
OPENAI_MAX_RETRIES=2
OPENAI_MAX_OUTPUT_TOKENS=900

# Budget and safety caps
# Global kill switch: refuses all AI calls; assignments, editing, running and submitting keep working.
AI_KILL_SWITCH=false
AI_MAX_TURNS_PER_SESSION=30
AI_MAX_TURNS_PER_USER_DAY=150
# Default per-course budget (USD) when a course has no CourseAiBudget row.
AI_COURSE_BUDGET_USD=250
AI_BUDGET_ALERT_PCT=80
AI_MAX_INPUT_TOKENS_PER_REQUEST=16000
AI_RATE_LIMIT_PER_MINUTE=12

# Planning prices in USD per 1M tokens (used for cost estimates; not quotes).
AI_PRICE_PROTECTED_INPUT_PER_1M=2.00
AI_PRICE_PROTECTED_CACHED_INPUT_PER_1M=0.20
AI_PRICE_PROTECTED_OUTPUT_PER_1M=10.00
AI_PRICE_ECONOMY_INPUT_PER_1M=0.10
AI_PRICE_ECONOMY_CACHED_INPUT_PER_1M=0.01
AI_PRICE_ECONOMY_OUTPUT_PER_1M=0.50
AI_PRICE_EMBEDDING_PER_1M=0.02

# ---------------------------------------------------------------------------
# File storage (course resources, research exports)
# ---------------------------------------------------------------------------
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# ---------------------------------------------------------------------------
# Code execution (never inside the Next.js process)
# ---------------------------------------------------------------------------
# docker = disposable local containers (--network none, --read-only, limits below); remote = HTTP sandbox service.
CODE_RUNNER_DRIVER=docker
RUNNER_TIMEOUT_MS=10000
RUNNER_SCALA_TIMEOUT_MS=45000
RUNNER_MEMORY=256m
RUNNER_CPUS=0.5
RUNNER_PIDS_LIMIT=64
RUNNER_OUTPUT_LIMIT_BYTES=65536
RUNNER_CONCURRENCY=4
# How long an API request waits for a queued run before reporting RUNNER_UNAVAILABLE.
RUNNER_WAIT_TIMEOUT_MS=60000
RUNNER_IMAGE_PYTHON=socra-runner-python:1
RUNNER_IMAGE_JAVASCRIPT=socra-runner-node:1
RUNNER_IMAGE_SCALA=socra-runner-scala:1
REMOTE_RUNNER_URL=
REMOTE_RUNNER_TOKEN=

# ---------------------------------------------------------------------------
# Worker / transactional outbox
# ---------------------------------------------------------------------------
WORKER_HEALTH_PORT=3001
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=8

# ---------------------------------------------------------------------------
# Analytics
# ---------------------------------------------------------------------------
# Denominators below this show "Insufficient data".
ANALYTICS_SMALL_N_THRESHOLD=5
ANALYTICS_TIMEZONE=America/New_York

# ---------------------------------------------------------------------------
# Research
# ---------------------------------------------------------------------------
# HMAC key for pseudonymous participant ids. Required in production; rotating it changes every research id.
RESEARCH_PSEUDONYM_SECRET=dev-only-research-pseudonym-secret-change-me
RESEARCH_EXPORT_DIR=./storage/exports

# ---------------------------------------------------------------------------
# Retention (days; 0 = no automatic action). Final values must be approved before pilot launch.
# The retention job only reports what it would do until RETENTION_ENFORCE=true.
# ---------------------------------------------------------------------------
RETENTION_ENFORCE=false
RETENTION_IDENTITY_DAYS=0
RETENTION_SUBMISSIONS_DAYS=0
RETENTION_GRADES_DAYS=0
RETENTION_RAW_AI_MESSAGES_DAYS=365
RETENTION_AI_REQUEST_LOGS_DAYS=400
RETENTION_LEARNING_EVIDENCE_DAYS=0
RETENTION_AGGREGATES_DAYS=0
RETENTION_RESEARCH_DAYS=0
RETENTION_AUDIT_LOG_DAYS=2555
RETENTION_SESSIONS_DAYS=30

# ---------------------------------------------------------------------------
# Feature flag defaults (environment scope). Course-level overrides are managed in Admin > Feature flags.
# ---------------------------------------------------------------------------
FEATURE_PROTECTED_SOCRA=true
FEATURE_PRACTICE_GENERATION=true
FEATURE_LEARNER_PROFILE=true
FEATURE_FACULTY_ANALYTICS=true
FEATURE_INDIVIDUAL_ANALYTICS=true
FEATURE_AI_GRADING_SUGGESTIONS=true
FEATURE_COURSE_RAG=true
FEATURE_POST_ASSESSMENT_SOLUTIONS=true
FEATURE_FACULTY_AI_AUTHORING=true

# ---------------------------------------------------------------------------
# Tests
# ---------------------------------------------------------------------------
PLAYWRIGHT_BASE_URL=http://localhost:3000

# --- Optional tooling overrides ---
# Path/name of the docker CLI used by the local code runner (default: docker).
DOCKER_BIN=
# Host the admin health page uses to reach the worker health server (default: 127.0.0.1).
WORKER_HEALTH_HOST=
# Set to 1 to run Playwright against `npm run build && npm start` instead of `npm run dev`.
E2E_USE_BUILD=
