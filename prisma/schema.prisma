// Socra Pilot Research V1 — complete data model.
//
// Conventions (see docs/ASSUMPTIONS.md):
// - Table/column names are Prisma defaults (PascalCase tables, camelCase columns). Quote them in raw SQL:
//   SELECT "courseId" FROM "ResourceChunk".
// - IDs are text (cuid by default) so the deterministic seed can use readable ids.
// - Planes (PRD Appendix D / data-pipelines digest):
//     identity        User, AuthIdentity, Session, PrivilegedAccessGrant
//     transactional   Course*, Topic*, Assignment*, Question*, Draft, CodeRun, Submission*, Grade*
//     conversation    AiSession, AiMessage (raw text; restricted), TranscriptAccessLog
//     learning        LearningEvidence (append-only), LearnerTopicState (derived), Misconception*, Practice*
//     analytics       AnalyticsEvent, OutboxEvent, ProcessedEvent, *Aggregate
//     research        StudyParticipant, ResearchParticipantMapping (protected), ResearchEvent, ResearchExport, DatasetManifest
//     model-improve   TrainingCandidate, DatasetVersion, HeldOutEvalItem
//     ops             FeatureFlag, AuditLog, BackgroundJobFailure, RetentionPolicy, RosterImport*
// - Telemetry/event tables deliberately carry ids WITHOUT foreign keys so they survive retention jobs
//   and can be pseudonymized independently.
// - Raw SQL in the init migration adds: pgvector extension, HNSW index on vector columns, tsvector
//   trigger + GIN index on ResourceChunk, append-only triggers on AuditLog / LearningEvidence /
//   HeldOutEvalItem / AnalyticsEvent.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

